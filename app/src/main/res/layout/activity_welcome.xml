<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/background"
        android:background="@drawable/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextView
        android:textSize="70sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/nameOfApp_Summons"
        android:padding="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-30dp"
        android:text="@string/app_name_1"
        android:shadowColor="#73716e"
        android:shadowDx="8"
        android:shadowDy="8"
        android:shadowRadius="8"
        android:layout_above="@+id/nameOfApp_Attack"
        android:layout_centerHorizontal="true"
        android:fontFamily="casual"/>
    <TextView
        android:textSize="50sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/nameOfApp_Attack"
        android:padding="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:text="@string/app_name_2"
        android:shadowColor="#73716e"
        android:shadowDx="8"
        android:shadowDy="8"
        android:shadowRadius="8"
        android:layout_above="@+id/startbutton"
        android:layout_centerHorizontal="true"
        android:fontFamily="casual"/>
    <ImageView
        android:id="@+id/best"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-10dp"
        android:src="@drawable/besttext"
        android:layout_above="@+id/C"
        android:layout_marginEnd="-40dp"
        android:layout_toStartOf="@+id/C"/>
    <ImageButton
        android:id="@+id/startbutton"
        android:background="@drawable/playbuttonwhite"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_marginBottom="320dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/text_size"
        android:textStyle="bold"
        android:textColor="@color/table_text_color"
        android:id="@+id/a1"
        android:layout_width="@dimen/widthA"
        android:layout_height="@dimen/height"
        android:layout_marginBottom="0dp"
        android:layout_alignParentBottom="true"
        android:fontFamily="casual"
        android:layout_marginEnd="0dp"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="@dimen/text_size"
        android:textStyle="bold"
        android:textColor="@color/table_text_color"
        android:id="@+id/b1"
        android:layout_width="@dimen/widthB"
        android:layout_height="@dimen/height"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="0dp"
        android:layout_alignBottom="@+id/a1"
        android:fontFamily="casual"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:layout_toStartOf="@+id/a1"/>
    <TextView
        android:textSize="@dimen/text_size"
        android:textStyle="bold"
        android:textColor="@color/table_text_color"
        android:id="@+id/c1"
        android:layout_width="@dimen/widthC"
        android:layout_height="@dimen/height"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="0dp"
        android:layout_alignBottom="@+id/b1"
        android:fontFamily="casual"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:layout_toStartOf="@+id/b1"/>
    <TextView
        android:textSize="@dimen/text_size"
        android:textStyle="bold"
        android:textColor="@color/table_text_color"
        android:id="@+id/a2"
        android:layout_width="@dimen/widthA"
        android:layout_height="@dimen/height"
        android:layout_marginBottom="0dp"
        android:layout_above="@+id/a1"
        android:fontFamily="casual"
        android:layout_marginEnd="0dp"
        android:layout_alignEnd="@+id/a1"/>
    <TextView
        android:textSize="@dimen/text_size"
        android:textStyle="bold"
        android:textColor="@color/table_text_color"
        android:id="@+id/b2"
        android:layout_width="@dimen/widthB"
        android:layout_height="@dimen/height"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="0dp"
        android:layout_above="@+id/b1"
        android:fontFamily="casual"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:layout_toStartOf="@+id/a1"/>
    <TextView
        android:textSize="@dimen/text_size"
        android:textStyle="bold"
        android:textColor="@color/table_text_color"
        android:id="@+id/c2"
        android:layout_width="@dimen/widthC"
        android:layout_height="@dimen/height"
        android:layout_marginBottom="0dp"
        android:layout_above="@+id/b1"
        android:fontFamily="casual"
        android:layout_marginEnd="0dp"
        android:layout_toStartOf="@+id/b1"/>
    <TextView
        android:textSize="@dimen/text_size"
        android:textStyle="bold"
        android:textColor="@color/table_text_color"
        android:id="@+id/a3"
        android:layout_width="@dimen/widthA"
        android:layout_height="@dimen/height"
        android:layout_marginBottom="0dp"
        android:layout_above="@+id/a2"
        android:fontFamily="casual"
        android:layout_marginEnd="0dp"
        android:layout_toStartOf="@+id/a2"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="@dimen/text_size"
        android:textStyle="bold"
        android:textColor="@color/table_text_color"
        android:id="@+id/b3"
        android:layout_width="@dimen/widthB"
        android:layout_height="@dimen/height"
        android:layout_marginBottom="0dp"
        android:layout_above="@+id/b2"
        android:fontFamily="casual"
        android:layout_marginEnd="0dp"
        android:layout_toStartOf="@+id/a2"/>
    <TextView
        android:textSize="@dimen/text_size"
        android:textStyle="bold"
        android:textColor="@color/table_text_color"
        android:id="@+id/c3"
        android:layout_width="@dimen/widthC"
        android:layout_height="@dimen/height"
        android:layout_marginBottom="0dp"
        android:layout_above="@+id/c2"
        android:fontFamily="casual"
        android:layout_marginEnd="0dp"
        android:layout_toStartOf="@+id/b3"/>
    <ImageView
        android:id="@+id/line"
        android:layout_width="@dimen/lineWidth"
        android:layout_height="5dp"
        android:layout_marginBottom="10dp"
        android:src="@color/white"
        android:layout_above="@+id/a3"
        android:layout_marginEnd="0dp"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="@dimen/text_size"
        android:textStyle="bold"
        android:textColor="@color/table_text_color"
        android:id="@+id/A"
        android:layout_width="@dimen/widthA"
        android:layout_height="@dimen/height"
        android:layout_marginBottom="10dp"
        android:layout_above="@+id/line"
        android:fontFamily="casual"
        android:layout_marginEnd="0dp"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="@dimen/text_size"
        android:textStyle="bold"
        android:textColor="@color/table_text_color"
        android:id="@+id/B"
        android:layout_width="@dimen/widthB"
        android:layout_height="@dimen/height"
        android:layout_marginBottom="0dp"
        android:layout_alignBottom="@+id/A"
        android:fontFamily="casual"
        android:layout_marginEnd="0dp"
        android:layout_toStartOf="@+id/A"/>
    <TextView
        android:textSize="@dimen/text_size"
        android:textStyle="bold"
        android:textColor="@color/table_text_color"
        android:id="@+id/C"
        android:layout_width="@dimen/widthC"
        android:layout_height="@dimen/height"
        android:layout_marginBottom="0dp"
        android:layout_alignBottom="@+id/B"
        android:fontFamily="casual"
        android:layout_marginEnd="0dp"
        android:layout_toStartOf="@+id/B"/>
    <TextView
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="@color/table_text_color"
        android:id="@+id/score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="0dp"
        android:text="score"
        android:layout_above="@+id/A"
        android:fontFamily="casual"
        android:layout_marginStart="0dp"
        android:layout_alignStart="@+id/A"/>
    <TextView
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="@color/table_text_color"
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="0dp"
        android:text="time"
        android:layout_above="@+id/B"
        android:fontFamily="casual"
        android:layout_marginStart="0dp"
        android:layout_alignStart="@+id/B"/>
    <ToggleButton
        android:id="@+id/toggleMusic"
        android:background="@drawable/ic_toggle_bg"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="0dp"
        android:checked="true"
        android:layout_above="@+id/toggleSounds"
        android:layout_marginStart="0dp"
        android:layout_alignStart="@+id/toggleSounds"
        style="@style/toggleButton"/>
    <ToggleButton
        android:id="@+id/toggleSounds"
        android:background="@drawable/ic_toggle_bg"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="0dp"
        android:checked="true"
        android:layout_above="@+id/best"
        android:layout_marginStart="10dp"
        android:layout_alignParentStart="true"
        style="@style/toggleButton"/>
    <ToggleButton
        android:id="@+id/toggleSystemInfo"
        android:background="@drawable/ic_toggle_bg"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="0dp"
        android:checked="false"
        android:layout_above="@+id/toggleMusic"
        android:layout_marginStart="10dp"
        android:layout_alignParentStart="true"
        style="@style/toggleButton"/>
    <TextView
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="@color/table_text_color"
        android:id="@+id/textMusic"
        android:layout_width="wrap_content"
        android:layout_height="25dp"
        android:layout_marginBottom="10dp"
        android:text="music"
        android:layout_alignBottom="@+id/toggleMusic"
        android:fontFamily="casual"
        android:layout_marginStart="5dp"
        android:layout_toEndOf="@+id/toggleMusic"/>
    <TextView
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="@color/table_text_color"
        android:id="@+id/textSound"
        android:layout_width="wrap_content"
        android:layout_height="25dp"
        android:layout_marginBottom="10dp"
        android:text="sound"
        android:layout_alignBottom="@+id/toggleSounds"
        android:fontFamily="casual"
        android:layout_marginStart="5dp"
        android:layout_toEndOf="@+id/toggleSounds"/>
    <TextView
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="@color/table_text_color"
        android:id="@+id/textSystemInfo"
        android:layout_width="wrap_content"
        android:layout_height="25dp"
        android:layout_marginBottom="10dp"
        android:text="fps"
        android:layout_above="@+id/toggleMusic"
        android:fontFamily="casual"
        android:layout_marginStart="0dp"
        android:layout_toEndOf="@+id/toggleSystemInfo"/>
    <ImageButton
        android:id="@+id/info"
        android:background="@drawable/info"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginBottom="10dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="10dp"
        android:layout_alignParentStart="true"/>
</RelativeLayout>
